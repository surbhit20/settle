# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# Both the Next.js app and the Python pipeline read .env.local.

# Local Docker database (see docker-compose.yml; host port 5433)
DATABASE_URL=postgres://settle:settle@localhost:5433/settle

# Mireye hidden-risk API, Bearer token (https://api.mireye.com)
MIREYE_API_TOKEN=

# US Census Data API, for ACS population (free: https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# FBI Crime Data Explorer, via a free api.data.gov key (https://api.data.gov/signup/)
# City-level crime rates shown on area cards only, not used in ranking (D033)
FBI_API_KEY=

# OpenRouteService (commute matrix)
ORS_API_KEY=

# TypeSafe AI Jev classifier (endpoint is a constant in code, from their docs; see D022)
JEV_API_KEY=

# Claude (explanations and fallback routing)
ANTHROPIC_API_KEY=
# Only if your API key isn't scoped to a workspace (requests then need the workspace ID)
ANTHROPIC_WORKSPACE_ID=

# RentCast (v2 live listings only)
RENTCAST_API_KEY=
# 511.org Open Data token: free at https://511.org/open-data/token (transit timetables)
TRANSIT_511_API_KEY=
