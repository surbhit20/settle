# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# python pipeline
pipeline/.venv/
__pycache__/
.pytest_cache/

# cached raw API responses and downloads (can be large; rebuildable)
data/raw/*
!data/raw/.gitkeep

# copied from node_modules by scripts/copy-maplibre-worker.mjs
/public/maplibre/

# derived pipeline outputs (rebuildable from data/raw)
data/processed/
